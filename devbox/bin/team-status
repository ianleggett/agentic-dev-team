#!/usr/bin/env bash
set -euo pipefail
export BEADS_DIR="${BEADS_DIR:-/workspace/.beads}"
READY="$(bd ready --json)"
printf '%-24s %-18s %s\n' PROJECT WORKER READY
printf '%s' "$READY" | jq -r '
 .[] |
 [(.labels//[])[]|select(startswith("project:"))] as $p |
 [(.labels//[])[]|select(startswith("worker:"))] as $w |
 select(($p|length)==1 and ($w|length)==1) |
 [$p[0],$w[0]]|@tsv' | sort | uniq -c | awk '{
 c=$1;p=$2;w=$3;sub(/^project:/,"",p);sub(/^worker:/,"",w);
 printf "%-24s %-18s %s\n",p,w,c
}'
echo
echo "Unroutable ready beads:"
printf '%s' "$READY" | jq -r '
 .[] |
 [(.labels//[])[]|select(startswith("project:"))] as $p |
 [(.labels//[])[]|select(startswith("worker:"))] as $w |
 select(($p|length)!=1 or ($w|length)!=1) |
 "\(.id)\t\(.title)\tprojects=\($p|join(",")) workers=\($w|join(","))"'
