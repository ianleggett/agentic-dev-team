#!/usr/bin/env bash
set -euo pipefail
[[ -d .git ]] || { echo "Run from repository root." >&2; exit 2; }
READY="$(bd ready --json)"
printf '%-20s %s\n' WORKER READY
for pair in \
  'architect worker:architect' 'tech-lead worker:tech-lead' 'java worker:java' \
  'frontend worker:frontend' 'database worker:database' 'devops worker:devops' \
  'qa worker:qa' 'review worker:review' 'security worker:security' 'docs worker:docs'; do
  name="${pair%% *}"; label="${pair#* }"
  count="$(printf '%s' "$READY" | jq --arg l "$label" '[.[] | select(((.labels // []) | index($l)) != null)] | length')"
  printf '%-20s %s\n' "$name" "$count"
done
