#!/usr/bin/env node

import { createServer } from 'node:http';
import { existsSync, readFileSync, readdirSync, statSync } from 'node:fs';
import { join, basename } from 'node:path';

const host = process.env.TEAM_RUNS_HOST || '0.0.0.0';
const port = Number(process.env.TEAM_RUNS_PORT || 3008);
const runsDir = process.env.TEAM_RUNS_DIR || '/workspace/.team-runs';
const maxLogBytes = Number(process.env.TEAM_WEB_MAX_LOG_BYTES || 200000);

const headers = {
  'access-control-allow-origin': 'same-origin',
  'cache-control': 'no-store'
};

function json(res, status, value) {
  res.writeHead(status, { ...headers, 'content-type': 'application/json; charset=utf-8' });
  res.end(JSON.stringify(value));
}

function runFiles() {
  if (!existsSync(runsDir)) return [];
  return readdirSync(runsDir)
    .filter((name) => name.endsWith('.json'))
    .map((name) => join(runsDir, name));
}

function runs() {
  return runFiles()
    .flatMap((path) => {
      try { return [JSON.parse(readFileSync(path, 'utf8'))]; } catch { return []; }
    })
    .sort((a, b) => String(b.started_at).localeCompare(String(a.started_at)));
}

function safeRunId(value) {
  return /^[A-Za-z0-9._:-]+$/.test(value || '') ? value : null;
}

function events(runId) {
  const path = join(runsDir, 'events', `${runId}.jsonl`);
  if (!existsSync(path)) return [];
  const text = readFileSync(path, 'utf8').slice(-maxLogBytes);
  return text.split('\n').filter(Boolean).flatMap((line) => {
    try { return [JSON.parse(line)]; } catch { return []; }
  });
}

const page = `<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>YAADT Team Runs</title><style>
:root{color-scheme:dark;font-family:Inter,ui-sans-serif,system-ui,sans-serif;background:#111318;color:#e8eaf0}
body{margin:0}.shell{max-width:1400px;margin:auto;padding:28px}.eyebrow{color:#8ca0c7;letter-spacing:.12em;text-transform:uppercase;font-size:11px}
h1{font-size:32px;margin:8px 0}.muted{color:#9399a8}.grid{display:grid;grid-template-columns:1.2fr 1fr;gap:18px;margin-top:24px}
.panel{background:#191c24;border:1px solid #2b3040;border-radius:12px;overflow:hidden}.toolbar{padding:12px 16px;border-bottom:1px solid #2b3040;display:flex;gap:10px;align-items:center}
table{width:100%;border-collapse:collapse}th,td{text-align:left;padding:11px 14px;border-bottom:1px solid #272c38;font-size:13px}th{color:#929bad;font-weight:500}
tr{cursor:pointer}tr:hover,tr.selected{background:#222735}.pill{border-radius:99px;padding:3px 8px;font-size:11px;background:#303747}.running{color:#82d6a2}.failed,.abandoned{color:#ff9d9d}.succeeded{color:#8bd5ff}
.detail{padding:18px;min-height:430px}.meta{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:18px 0}.meta div{background:#202431;border-radius:8px;padding:10px}.meta b{display:block;font-size:11px;color:#8e98ad;margin-bottom:4px}
 .output-tools{display:flex;flex-wrap:wrap;gap:8px;margin:10px 0}.output-tools input,.output-tools select{background:#101218;color:#e8eaf0;border:1px solid #3a4050;border-radius:6px;padding:8px;font:inherit}.output-tools input{min-width:220px;flex:1}.events-wrap{overflow:auto;max-height:390px;background:#101218;border-radius:8px}.events-table{min-width:680px}.events-table th{position:sticky;top:0;background:#171a22;z-index:1}.events-table th button{background:none;border:0;color:inherit;font:inherit;cursor:pointer;padding:0}.events-table td{vertical-align:top}.events-table td:first-child{white-space:nowrap;color:#aab2c3;font:12px ui-monospace,SFMono-Regular,monospace}.events-table td:nth-child(2){white-space:nowrap;color:#8fa8d8}.event-message{white-space:pre-wrap;word-break:break-word;font:12px ui-monospace,SFMono-Regular,monospace}.empty-output{padding:18px;color:#9399a8}
@media(max-width:900px){.grid{grid-template-columns:1fr}.shell{padding:16px}}
</style></head><body><main class="shell"><div class="eyebrow">Agent operations</div><h1>Team Runs</h1><div class="muted">Live worker leases, execution history, and redacted agent output.</div><div class="grid"><section class="panel"><div class="toolbar"><strong>Runs</strong><span id="count" class="muted"></span></div><table><thead><tr><th>Role</th><th>Bead</th><th>State</th><th>Heartbeat</th></tr></thead><tbody id="runs"></tbody></table></section><section class="panel"><div id="detail" class="detail"><div class="muted">Select a run to inspect its output.</div></div></section></div></main><script>
 let data=[],selected=null,selectedEvents=[],eventFilter='',eventKind='',eventSort='at',eventDescending=true;
const esc=(v)=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const age=(v)=>v?new Date(v).toLocaleString():'-';
async function load(){const r=await fetch('/api/runs');data=await r.json();render();if(selected)loadDetail(selected)}
function render(){document.querySelector('#count').textContent=data.length+' total';document.querySelector('#runs').innerHTML=data.map(r=>'<tr class="'+(r.run_id===selected?'selected':'')+'" data-id="'+esc(r.run_id)+'"><td>'+esc(r.role)+'</td><td>'+esc(r.bead_id)+'</td><td><span class="pill '+esc(r.state)+'">'+esc(r.state)+'</span></td><td>'+esc(age(r.last_heartbeat_at))+'</td></tr>').join('');document.querySelectorAll('tr[data-id]').forEach(e=>e.onclick=()=>loadDetail(e.dataset.id))}
 function eventTime(v){return v?new Date(v).toLocaleString():'-'}
 function renderEvents(){const target=document.querySelector('#event-output');if(!target)return;const kinds=[...new Set(selectedEvents.map(x=>x.kind).filter(Boolean))].sort();const filtered=selectedEvents.filter(x=>(!eventKind||x.kind===eventKind)&&(!eventFilter||String(x.message??'').toLowerCase().includes(eventFilter.toLowerCase())||String(x.kind??'').toLowerCase().includes(eventFilter.toLowerCase()))).sort((a,b)=>{const av=String(a[eventSort]??''),bv=String(b[eventSort]??'');const result=eventSort==='at'?av.localeCompare(bv):av.localeCompare(bv);return eventDescending?-result:result});target.innerHTML='<div class="output-tools"><input id="event-filter" type="search" placeholder="Filter output..." value="'+esc(eventFilter)+'"><select id="event-kind"><option value="">All event types</option>'+kinds.map(k=>'<option value="'+esc(k)+'"'+(k===eventKind?' selected':'')+'>'+esc(k)+'</option>').join('')+'</select><span class="muted">'+filtered.length+' of '+selectedEvents.length+' events</span></div><div class="events-wrap"><table class="events-table"><thead><tr><th><button data-sort="at">Time '+(eventSort==='at'?(eventDescending?'↓':'↑'):'')+'</button></th><th><button data-sort="kind">Type '+(eventSort==='kind'?(eventDescending?'↓':'↑'):'')+'</button></th><th><button data-sort="message">Message '+(eventSort==='message'?(eventDescending?'↓':'↑'):'')+'</button></th></tr></thead><tbody>'+ (filtered.length?filtered.map(x=>'<tr><td>'+esc(eventTime(x.at))+'</td><td>'+esc(x.kind)+'</td><td class="event-message">'+esc(x.message)+'</td></tr>').join(''):'<tr><td colspan="3" class="empty-output">No matching events.</td></tr>')+'</tbody></table></div>';document.querySelector('#event-filter').oninput=(ev)=>{eventFilter=ev.target.value;renderEvents()};document.querySelector('#event-kind').onchange=(ev)=>{eventKind=ev.target.value;renderEvents()};document.querySelectorAll('[data-sort]').forEach(button=>button.onclick=()=>{const sort=button.dataset.sort;if(eventSort===sort)eventDescending=!eventDescending;else{eventSort=sort;eventDescending=false}renderEvents()})}
 async function loadDetail(id){selected=id;render();const r=data.find(x=>x.run_id===id),e=await (await fetch('/api/runs/'+encodeURIComponent(id)+'/events')).json();selectedEvents=e;document.querySelector('#detail').innerHTML='<h2>'+esc(r.role)+' <span class="pill '+esc(r.state)+'">'+esc(r.state)+'</span></h2><div class="muted">'+esc(r.project)+' / '+esc(r.bead_id)+'</div><div class="meta"><div><b>Run</b>'+esc(r.run_id)+'</div><div><b>Worker</b>'+esc(r.worker_id)+'</div><div><b>Started</b>'+esc(age(r.started_at))+'</div><div><b>Finished</b>'+esc(age(r.finished_at))+'</div><div><b>Lease expires</b>'+esc(age(r.lease_expires_at))+'</div><div><b>Exit code</b>'+esc(r.exit_code)+'</div></div><h3>Agent output</h3><div id="event-output"></div>';renderEvents()}
load();setInterval(load,5000);
</script></body></html>`;

const server = createServer((req, res) => {
  const url = new URL(req.url, `http://${req.headers.host}`);
  if (url.pathname === '/api/runs') return json(res, 200, runs());
  const match = url.pathname.match(/^\/api\/runs\/([^/]+)\/events$/);
  if (match) {
    const id = safeRunId(decodeURIComponent(match[1]));
    return id ? json(res, 200, events(id)) : json(res, 400, { error: 'invalid run id' });
  }
  res.writeHead(200, { ...headers, 'content-type': 'text/html; charset=utf-8' });
  res.end(page);
});

server.listen(port, host, () => console.log(`Team Runs UI listening on http://${host}:${port}`));
