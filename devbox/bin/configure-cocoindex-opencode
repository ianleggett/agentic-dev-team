#!/usr/bin/env bash
set -euo pipefail

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/opencode"
CONFIG_FILE="${CONFIG_DIR}/opencode.json"

mkdir -p "$CONFIG_DIR"

if [[ ! -f "$CONFIG_FILE" ]]; then
  printf '%s\n' '{}' > "$CONFIG_FILE"
fi

if ! jq empty "$CONFIG_FILE" >/dev/null 2>&1; then
  echo "ERROR: Existing OpenCode config is not valid JSON: $CONFIG_FILE" >&2
  exit 2
fi

TMP="$(mktemp "${CONFIG_FILE}.XXXXXX")"
trap 'rm -f "$TMP"' EXIT

jq '
  .mcp = (.mcp // {}) |
  .mcp["cocoindex-code"] = {
    "type": "local",
    "command": ["ccc", "mcp"]
  } |
  .permission = (.permission // {}) |
  .permission.external_directory =
    ((.permission.external_directory // {})
     | .["/opt/agent-team/**"] = "allow"
     | .["/workspace/**"] = "allow"
     | .["/tmp/**"] = "allow"
     | .["/home/developer/**"] = "allow") |
  .permission.bash = (.permission.bash // "allow") |
  .permission.edit = (.permission.edit // "allow")
' "$CONFIG_FILE" > "$TMP"

mv "$TMP" "$CONFIG_FILE"
trap - EXIT

echo "OpenCode MCP + worker permissions configured in:"
echo "  $CONFIG_FILE"
echo
jq '{mcp: .mcp["cocoindex-code"], permission: .permission}' "$CONFIG_FILE"
