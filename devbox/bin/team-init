#!/usr/bin/env bash
set -euo pipefail
export BEADS_DIR="${BEADS_DIR:-/workspace/.beads}"
mkdir -p /workspace
cd /workspace
if [[ ! -d "$BEADS_DIR" ]]; then
  echo "Initialising shared Beads DB: $BEADS_DIR"
  bd init --quiet --stealth
else
  echo "Shared Beads DB already exists: $BEADS_DIR"
fi
configure-cocoindex-opencode 2>/dev/null || true
cat <<'EOF'
YAADT multi-project workspace ready.

Register repos:
  project-add org-chart
  project-add invoice-system

List projects:
  project-list

Plan:
  spec-writer --project org-chart docs/ideas/feature.md
  solution-architect --project org-chart docs/specs/feature.md
  tech-lead --project org-chart docs/architecture/feature.md

Run:
  team-status
  java-dev
EOF
