#!/usr/bin/env bash
set -euo pipefail

[[ -d .git ]] || { echo "Run from repository root." >&2; exit 2; }

if [[ ! -d .beads ]]; then
  bd init --quiet
fi

bd setup opencode || true

mkdir -p docs/specs docs/architecture docs/ideas

if command -v configure-cocoindex-opencode >/dev/null 2>&1; then
  configure-cocoindex-opencode || echo "WARNING: Could not configure CocoIndex MCP."
fi

cat <<'TXT'
Agent team initialised.

CocoIndex Code is installed in the devbox.
For a new repository, initialise/index it once with:
  cocoindex-project-init

Suggested flow:
  spec-writer docs/ideas/feature.md
  solution-architect docs/specs/feature.md
  tech-lead docs/architecture/feature.md
  team-status
  java-dev / frontend-dev / database-dev / devops
  qa-test
  code-reviewer
  security-reviewer
  docs-writer
TXT
