#!/usr/bin/env bash
set -euo pipefail

export BEADS_DIR="${BEADS_DIR:-/workspace/.beads}"
export TEAM_RUNS_DIR="${TEAM_RUNS_DIR:-/workspace/.team-runs}"

usage() {
  echo "Usage: team-autorun [--max <rounds>] [--watch] [--sleep <seconds>]" >&2
  exit 2
}

MAX=50
WATCH=false
SLEEP_SECONDS=30

while [[ $# -gt 0 ]]; do
  case "$1" in
    --max) [[ $# -ge 2 ]] || usage; MAX="$2"; shift 2 ;;
    --watch) WATCH=true; shift ;;
    --sleep) [[ $# -ge 2 ]] || usage; SLEEP_SECONDS="$2"; shift 2 ;;
    *) usage ;;
  esac
done

[[ -d "$BEADS_DIR" ]] || { echo "Shared Beads DB missing: $BEADS_DIR (run team-init first)" >&2; exit 2; }
command -v /usr/local/libexec/_team-run >/dev/null 2>&1 || { echo "team run runtime missing" >&2; exit 2; }

RUN_ID="autorun-$(date -u +%Y%m%dT%H%M%S)-$$-${RANDOM}"
/usr/local/libexec/_team-run create "$RUN_ID" dispatcher none workspace "team-autorun@${HOSTNAME:-unknown}:$$" >/dev/null
FINALIZED=false
HEARTBEAT_PID=""
finish_dispatcher() {
  local status=$?
  if [[ -n "$HEARTBEAT_PID" ]]; then
    kill "$HEARTBEAT_PID" 2>/dev/null || true
    wait "$HEARTBEAT_PID" 2>/dev/null || true
  fi
  if [[ "$FINALIZED" != "true" ]]; then
    /usr/local/libexec/_team-run finish "$RUN_ID" failed "$status" >/dev/null 2>&1 || true
  fi
  exit "$status"
}
trap finish_dispatcher EXIT INT TERM

dispatcher_heartbeat() {
  while kill -0 "$$" 2>/dev/null; do
    sleep "${TEAM_HEARTBEAT_SECONDS:-20}"
    kill -0 "$$" 2>/dev/null || break
    /usr/local/libexec/_team-run heartbeat "$RUN_ID" >/dev/null 2>&1 || true
  done
}
dispatcher_heartbeat &
HEARTBEAT_PID=$!
/usr/local/libexec/_team-run heartbeat "$RUN_ID" >/dev/null

routable_count() {
  bd ready --json | jq -r '
    [.[] |
      [(.labels//[])[] | select(startswith("project:"))] as $p |
      [(.labels//[])[] | select(startswith("worker:"))] as $w |
      select(($p|length)==1 and ($w|length)==1)
    ] | length'
}

run_round() {
  local worker
  for worker in spec-writer solution-architect tech-lead \
                fullstack-dev database-dev devops \
                qa-test code-reviewer security-reviewer docs-writer; do
    command -v "$worker" >/dev/null 2>&1 || continue
    echo "--- $(date '+%H:%M:%S') $worker ---"
    /usr/local/libexec/_team-run event "$RUN_ID" worker "starting $worker" || true
    set +e
    "$worker"
    local status=$?
    set -e
    /usr/local/libexec/_team-run event "$RUN_ID" worker "$worker exited with status $status" || true
  done
}

if [[ "$WATCH" == "true" ]]; then
  while true; do
    if [[ "$(routable_count)" != "0" ]]; then
      run_round
    else
      sleep "$SLEEP_SECONDS"
    fi
  done
fi

ROUND=0
while (( ROUND < MAX )); do
  ROUTABLE="$(routable_count)"
  if [[ "$ROUTABLE" == "0" ]]; then
    echo "No routable ready beads; stopping."
    break
  fi
  ROUND=$((ROUND + 1))
  echo "=== Round $ROUND/$MAX: $ROUTABLE routable ready bead(s) ==="
  run_round
done

/usr/local/libexec/_team-run finish "$RUN_ID" succeeded 0 >/dev/null
FINALIZED=true
