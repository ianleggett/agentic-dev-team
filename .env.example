# YAADT environment file. Copy to .env and edit; Docker Compose reads
# .env automatically for ${VAR} interpolation. .env itself is gitignored —
# never commit real keys or private key paths.

# ---------------------------------------------------------------------------
# Host identity
# ---------------------------------------------------------------------------

# Host UID/GID of the account that owns ./workspace and runs Compose
# (check with: id -u / id -g). Used for the bind-mount ownership repair,
# the devbox developer account, and container run-as. Set both or neither;
# 1000/1000 are the defaults.
USER_UID=1000
USER_GID=1000

# ---------------------------------------------------------------------------
# Build-time security gates
# ---------------------------------------------------------------------------

# npm audit level that FAILS the devbox and beads-ui builds at or above
# this severity. Keep at high; do not lower it just to get a green build.
NPM_AUDIT_LEVEL=high

# Git ref of mantoni/beads-ui to build (default: main). Consider pinning
# to a commit SHA for reproducibility.
#BEADS_UI_REF=main

# ---------------------------------------------------------------------------
# LLM inference (runtime)
# ---------------------------------------------------------------------------

# Bearer key for the OpenAI-compatible endpoint, only if it requires one.
# Leave empty for a keyless LAN endpoint.
# The endpoint URL and model id are NOT set here — they live in
# devbox:/home/developer/.config/opencode/opencode.json (see README).
LLM_API_KEY=

# ---------------------------------------------------------------------------
# Git identity for commits workers make inside the devbox
# ---------------------------------------------------------------------------

GIT_AUTHOR_NAME=Developer
GIT_AUTHOR_EMAIL=developer@local

# ---------------------------------------------------------------------------
# Gitea / git access
# ---------------------------------------------------------------------------

# Base URL of your Gitea instance (e.g. https://gitea.example.internal or
# http://host.docker.internal:3000 for a host-run Gitea). Unset emits
# Compose interpolation warnings; workers then have no default remote.
GITEA_URL=

# Host path to the SSH PRIVATE key mounted read-only into the devbox for
# git+ssh access to Gitea; its .pub half must be registered in Gitea.
# Defaults to $HOME/.ssh/gitea when unset. Must be an absolute path when
# set. The file must EXIST on the host or the devbox container fails to
# start (single-file bind mount); without a valid key, worker git+ssh
# clones/pushes will not authenticate.
#SSH_GITEA_KEY=/home/you/.ssh/gitea

# ---------------------------------------------------------------------------
# Notes (vars NOT settable via this file)
# ---------------------------------------------------------------------------
# - FIX_WORKSPACE_PERMISSIONS (default true): set to "false" in the devbox
#   service's environment block in docker-compose.yml to disable the
#   bind-mount ownership repair at startup.
# - Verify LLM reachability from inside the devbox before debugging
#   OpenCode:  curl <endpoint>/v1/models
